   <string notr="true">

QWidget#Form {
    background-color: #242526;
    color: #d7d9dc;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 11px;
}
QPushButton {
    background-color: #303236;
    color: #d7d9dc;
    border: 1px solid #4a4d52;
    border-radius: 2px;
    padding: 3px 6px;
}
QPushButton:hover {
    background-color: #383b40;
    border-color: #6ad8df;
}
QPushButton:pressed, QPushButton:checked {
    background-color: #195f66;
    border-color: #7beef5;
    color: #ffffff;
}
QPushButton:disabled {
    background-color: #282a2d;
    color: #666b72;
    border-color: #383b40;
}
QPushButton#btn_load_seq {
    background-color: #303236;
    border-radius: 2px;
    padding-left: 10px;
    padding-right: 12px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#btn_load_seq:hover {
    background-color: #383b40;
}
QPushButton#btn_brush_color {
    border: 1px solid #111214;
    border-radius: 1px;
}
QLabel#viewer {
    background-color: #1a1b1d;
    border: 1px solid #4b4f56;
    border-radius: 0px;
    color: #6f747d;
    font-size: 12px;
}
QLabel#layersTitle {
    color: #f1f3f4;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding-left: 0px;
}
QListWidget#lw_layers {
    background-color: #2b2d30;
    border: 1px solid #4b4f56;
    border-radius: 0px;
    padding: 2px;
    outline: none;
}
QListWidget#lw_layers::item {
    min-height: 22px;
    border-radius: 0px;
    padding: 2px 5px;
}
QListWidget#lw_layers::item:selected {
    background-color: #087ea4;
    color: #ffffff;
}
QListWidget#lw_layers::item:hover {
    background-color: #36393e;
}
QSpinBox#sb_time_shift {
    background-color: #2b2d30;
    color: #d7d9dc;
    border: 1px solid #4b4f56;
    border-radius: 0px;
    padding-left: 5px;
}
QLabel#maxframe, QLabel#refframe, QLabel#label_4 {
    font-weight: 600;
    color: #f1f3f4;
    font-size: 12px;
}
QLabel#state {
    color: #8d939c;
    padding-left: 8px;
}
QSlider::groove:horizontal {
    height: 40px;
    background: #555a62;
    border-radius: 0px;
}
QSlider::handle:horizontal {
    background: #58d1d8;
    width: 20px;
    margin: -5px 0;
    border-radius: 0px;
}
QSlider::groove:vertical {
    width: 40px;
    background: #555a62;
    border-radius: 0px;
}
QSlider::handle:vertical {
    background: #58d1d8;
    height: 40px;
    margin: 0 -5px;
    border-radius: 0px;
}
