  <property name="styleSheet">
   <string notr="true">
QWidget#Form {
    background-color: #444444;
    color: #e0e0e0;
    font-family: Segoe UI, Arial, sans-serif;
    font-size: 12px;
}
QLabel {
    color: #e0e0e0;
}
QPushButton {
    background-color: #333333;
    color: #e0e0e0;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 10px;
    text-align: left;
}
QPushButton:hover {
    background-color: #3d3d3d;
    border-color: #666666;
}
QPushButton:pressed {
    background-color: #2b2b2b;
}
QPushButton:checked {
    background-color: #4b7bbd;
    border-color: #4b7bbd;
    color: #ffffff;
}
QPushButton:disabled {
    color: #808080;
    background-color: #3a3a3a;
    border-color: #4a4a4a;
}
QPushButton#btn_s_frame, QPushButton#btn_p_frame, QPushButton#btn_play,
QPushButton#btn_n_frame, QPushButton#btn_e_frame, QPushButton#btn_loop,
QPushButton#btn_add_layer, QPushButton#btn_remove_layer {
    padding: 4px;
    text-align: center;
}
QLabel#viewer {
    background-color: #4a4a4a;
    border: none;
    color: #9a9a9a;
}
QLabel#layersTitle {
    font-weight: 600;
}
QListWidget#lw_layers {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#lw_layers::item {
    background-color: #3a3a3a;
    min-height: 36px;
    padding: 4px 10px;
    margin: 3px 2px;
    border-radius: 6px;
    color: #e0e0e0;
}
QListWidget#lw_layers::item:selected {
    background-color: #4b7bbd;
    color: #ffffff;
}
QListWidget#lw_layers::item:hover:!selected {
    background-color: #454545;
}
QSpinBox#sb_time_shift, QSpinBox#sb_ghosting {
    background-color: #333333;
    color: #e0e0e0;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 2px 6px;
}
QSlider::groove:horizontal {
    height: 3px;
    background: #666666;
    border-radius: 1px;
}
QSlider::sub-page:horizontal {
    background: #3a9ad9;
    border-radius: 1px;
}
QSlider::handle:horizontal {
    background: #3a9ad9;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 2px;
}
   </string>
